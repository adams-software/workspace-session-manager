#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: wsm_logs_viewer <log-path>" >&2
  exit 2
fi

LOG_PATH="$1"
if [[ ! -f "$LOG_PATH" ]]; then
  echo "wsm_logs_viewer: log not found: $LOG_PATH" >&2
  exit 1
fi

trap 'printf "\033[0m\033[?25h\033[?1049l\033(B"' EXIT
printf "\033[?1049h\033[2J\033[H\033[?25h"

less +G -R -X "$LOG_PATH"
