#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: wsm_logs_viewer <log-path>" >&2
  exit 2
fi

LOG_PATH="$1"
shopt -s nullglob
SEGMENTS=( "$LOG_PATH".[0-9][0-9][0-9][0-9][0-9][0-9] )
if [[ -f "$LOG_PATH" ]]; then
  SEGMENTS+=( "$LOG_PATH" )
fi

if [[ ${#SEGMENTS[@]} -eq 0 ]]; then
  echo "wsm_logs_viewer: log not found: $LOG_PATH" >&2
  exit 1
fi

# less defaults to byte escaping like <E2><80><A2> unless it is told the
# stream is UTF-8. Force that so emoji and other multibyte glyphs render
# as real Unicode instead of hex byte dumps.
export LESSCHARSET="${LESSCHARSET:-utf-8}"

# Some launch contexts inherit TERM=dumb, which makes less warn that the
# terminal is not fully functional. Force a sensible fallback in that case.
if [[ -z "${TERM:-}" || "$TERM" == "dumb" ]]; then
  export TERM=xterm-256color
fi

TMP_STITCHED=""
cleanup() {
  if [[ -n "$TMP_STITCHED" ]]; then
    rm -f "$TMP_STITCHED"
  fi
  printf "\033[0m\033[?25h\033[?1049l\033(B"
}
trap cleanup EXIT
printf "\033[?1049h\033[2J\033[H\033[?25h"

if [[ ${#SEGMENTS[@]} -eq 1 ]]; then
  less +G -R -X "${SEGMENTS[0]}"
  exit $?
fi

TMP_STITCHED="$(mktemp)"
cat "${SEGMENTS[@]}" > "$TMP_STITCHED"
less +G -R -X "$TMP_STITCHED"
