#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: wsm_logs_viewer <typescript-path>" >&2
  exit 2
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"

if [[ -x "$SCRIPT_DIR/scroll" ]]; then
  SCROLL_BIN="$SCRIPT_DIR/scroll"
elif [[ -x "$SCRIPT_DIR/../../zig-out/bin/scroll" ]]; then
  SCROLL_BIN="$SCRIPT_DIR/../../zig-out/bin/scroll"
else
  echo "wsm_logs_viewer: could not find scroll helper" >&2
  exit 1
fi

trap 'stty sane 2>/dev/null || true; clear 2>/dev/null || true' EXIT

stty sane 2>/dev/null || true
clear 2>/dev/null || true

"$SCROLL_BIN" --ansi "$1" | less +G -R -X
