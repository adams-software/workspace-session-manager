#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: wsm_logs_viewer <typescript-path>" >&2
  exit 2
fi

TRANSCRIPT_PATH="$1"
if [[ ! -f "$TRANSCRIPT_PATH" ]]; then
  echo "wsm_logs_viewer: transcript not found: $TRANSCRIPT_PATH" >&2
  exit 1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"

if [[ -x "$SCRIPT_DIR/scroll" ]]; then
  SCROLL_BIN="$SCRIPT_DIR/scroll"
elif [[ -x "$SCRIPT_DIR/../../zig-out/bin/scroll" ]]; then
  SCROLL_BIN="$SCRIPT_DIR/../../zig-out/bin/scroll"
else
  echo "wsm_logs_viewer: could not find scroll helper" >&2
  exit 1
fi

"$SCROLL_BIN" --ansi "$TRANSCRIPT_PATH" | less -R -X
